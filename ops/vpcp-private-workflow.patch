--- a/.github/workflows/vietnam_private_first_collector.yml
+++ b/.github/workflows/vietnam_private_first_collector.yml
@@ -290,6 +290,36 @@
           review(Path(sys.argv[1])/'state',sys.argv[2])
           PY
           done
+      - name: Collect permitted Government Office originals
+        continue-on-error: true
+        if: ${{ env.MODE == 'collect_after_cutover' && vars.VIETNAM_VPCP_TEXT_ENABLED == 'true' }}
+        env:
+          GH_TOKEN: ${{ github.token }}
+          VIETNAM_VPCP_TEXT_ENABLED: ${{ vars.VIETNAM_VPCP_TEXT_ENABLED }}
+          VIETNAM_PRIVATE_BRIDGE_KEY: ${{ secrets.VIETNAM_PRIVATE_BRIDGE_KEY }}
+        run: |
+          set -euo pipefail
+          umask 077
+          auth="$(printf 'x-access-token:%s' "$GH_TOKEN" | base64 -w0)"
+          private_git() { git -c "http.https://github.com/.extraheader=AUTHORIZATION: basic $auth" "$@"; }
+          dest="$RUNNER_TEMP/vpcp-custody"
+          if private_git ls-remote --exit-code "$PRIVATE_URL" refs/heads/archive/vietnam-vpcp > /dev/null; then
+            private_git clone --quiet --single-branch --branch archive/vietnam-vpcp "$PRIVATE_URL" "$dest"
+          else
+            git init --quiet -b archive/vietnam-vpcp "$dest"
+            git -C "$dest" remote add origin "$PRIVATE_URL"
+          fi
+          cd ipr
+          python -m scripts.collect_vpcp_private_documents --database pla_watch.db \
+            --private-repo "$dest" --gate-dir "$RUNNER_TEMP/vpcp-host-gate"
+          git -C "$dest" config user.name 'github-actions[bot]'
+          git -C "$dest" config user.email '41898282+github-actions[bot]@users.noreply.github.com'
+          git -C "$dest" add state/
+          if ! git -C "$dest" diff --cached --quiet; then
+            git -C "$dest" commit -m "VPCP private source: $GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
+            private_git -C "$dest" push origin HEAD:refs/heads/archive/vietnam-vpcp
+          fi
+
       # Shared Vietnam Daily, private half: the public repository's bridge runs
