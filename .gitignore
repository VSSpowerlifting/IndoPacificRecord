# Secrets
.env

# Runtime artifacts
cache/
/briefs/.approval.lock
pla_watch.db-shm
pla_watch.db-wal
graphify-out/

# Claude Code / agent tooling
# Ignore all local/runtime .claude state, but version the project-owned
# agent and command definitions.
.claude/*
!.claude/agents/
!.claude/commands/
# Shared repo skills: canonical copy in .agents/skills (read by Codex), exposed
# to Claude through a tracked symlink. Other local skills stay ignored.
!.claude/skills/
.claude/skills/*
!.claude/skills/ipr-proposal-review
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/ipr-proposal-review/
tmp/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Rendered output of the private regional-IA prototype. Disposable; rebuild with
# `.venv/bin/python site/preview/generate_preview.py`. Root-anchored on purpose:
# a bare `preview/` also matches site/preview/, which is tracked SOURCE.
/preview/

# Disposable screenshot set for private prototype review.
/preview-review-shots/

# Retired Ruflo/claude-flow swarm runtime state (never tracked again).
/.claude-flow/
